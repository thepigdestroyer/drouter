# Tinfoil enclave inference API key used by the oblivious relay and OpenAI-compatible gateway
TINFOIL_API_KEY=

# MongoDB Atlas connection string (user drouter-app has readWrite on the drouter database only)
MONGODB_URI=

# MongoDB database name (defaults to "drouter" when unset)
MONGODB_DB=

# Circle Arc Testnet JSON-RPC endpoint URL (chain ID 5042002)
ARC_RPC_URL=

# Deployed DRouterRegistry contract address on Circle Arc Testnet (0xbc8085c2b6fe6e0db05f169925c0b841828f4481)
ARC_REGISTRY_ADDRESS=

# Public client-visible DRouterRegistry contract address on Circle Arc Testnet
NEXT_PUBLIC_ARC_REGISTRY_ADDRESS=

# Circle Arc Testnet private key for the authorised verifier wallet that records verifications and anchors receipts
ARC_VERIFIER_PRIVATE_KEY=

# Circle Arc Testnet private key for the deployer/operator wallet used by scripts/arc-deploy.mjs and scripts/arc-seed.mjs
ARC_DEPLOYER_PRIVATE_KEY=

# 32-byte hex seed used to derive deterministic simulated hardware roots and node keys (sim-1, sim-2, sim-3)
SIM_HARDWARE_SEED=

# 2048-bit RSA prime pair (p_hex:q_hex) for signing unlinkable blind credit tokens in production
CREDITS_ISSUER_RSA_PQ=

# Optional hex seed fallback for deriving the blind-credit RSA issuer key in local development or tests
CREDITS_ISSUER_SEED=

# Bearer secret verified by GET /api/cron/auditor when triggered by the daily Vercel Cron job
CRON_SECRET=

# Shared secret token required in the X-Atlas-Ingest-Token header for POST /api/atlas document ingestion
ATLAS_INGEST_TOKEN=

# Optional Google Gemini API key for live Gemini 4 Argon Interactions API calls (runs in labelled simulated mode when unset)
GEMINI_API_KEY=

# Optional Voyage AI API key for live 128-d query embeddings in MongoDB Atlas hybrid search (uses local-hashed-128 stand-in when unset)
VOYAGE_API_KEY=

# Optional Voyage AI embedding model identifier (defaults to "voyage-3-lite" when unset)
VOYAGE_MODEL=

# Optional flag ("1") to stub upstream Tinfoil, MongoDB, and Arc network calls during offline or stress testing
DROUTER_STUB_UPSTREAM=

# Optional default model identifier for scripts/drouter-cli.mjs (defaults to "kimi-k3")
DROUTER_MODEL=

# Optional upstream dRouter base URL for scripts/drouter-cli.mjs and scripts/drouter-proxy.mjs
DROUTER_UPSTREAM=

# Optional local listening port for scripts/drouter-cli.mjs and scripts/drouter-proxy.mjs (defaults to 4141)
DROUTER_PROXY_PORT=

# Optional flag to enable a live chat completion during scripts/smoke-tinfoil.mjs
SMOKE_CHAT=

# Optional target base URL for scripts/stress-test.mjs (defaults to "http://127.0.0.1:3200")
STRESS_BASE_URL=

# Optional request concurrency level for scripts/stress-test.mjs (defaults to 200)
STRESS_CONCURRENCY=

# Optional Vercel OIDC token injected by the Vercel runtime environment
VERCEL_OIDC_TOKEN=
